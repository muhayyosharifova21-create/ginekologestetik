    </div>
  </footer>
</div>

<style>
  body {
    margin: 0;
    font-family: 'Inter', sans-serif;
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    color: #1e293b;
    min-height: 100vh;
  }
  .site-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 30px 20px 40px 20px;
  }

  /* 3D Glassmorphism Creative Hero Section */
  .hero-section {
    margin-bottom: 40px;
    display: flex;
    justify-content: center;
  }
  .hero-creative-card {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(240, 249, 255, 0.9) 100%);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border: 1px solid rgba(255, 255, 255, 1);
    border-radius: 32px;
    padding: 50px 30px 35px 30px;
    text-align: center;
    box-shadow: 
      0 25px 50px rgba(15, 23, 42, 0.08),
      0 4px 12px rgba(2, 132, 199, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 1);
    position: relative;
    overflow: hidden;
  }
  
  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(50px);
    z-index: 0;
    pointer-events: none;
  }
  .glow-orb-1 {
    width: 250px;
    height: 250px;
    background: rgba(2, 132, 199, 0.12);
    top: -80px;
    left: -80px;
  }
  .glow-orb-2 {
    width: 250px;
    height: 250px;
    background: rgba(244, 63, 94, 0.08);
    bottom: -80px;
    right: -80px;
  }

  .hero-content-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .magazine-tag {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 800;
    color: #0284c7;
    background: linear-gradient(135deg, rgba(2, 132, 199, 0.15) 0%, rgba(56, 189, 248, 0.1) 100%);
    padding: 6px 18px;
    border-radius: 50px;
    letter-spacing: 2px;
    margin-bottom: 20px;
    text-transform: uppercase;
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.08);
    border: 1px solid rgba(2, 132, 199, 0.2);
  }
  .main-title {
    font-size: 3.2rem;
    color: #0f172a;
    margin: 0 0 12px 0;
    font-weight: 900;
    letter-spacing: -1px;
  }
  .doctor-name {
    font-size: 1.5rem;
    color: #334155;
    margin: 0 0 25px 0;
    font-weight: 700;
  }
  .quote {
    font-style: italic;
    color: #475569;
    background: rgba(255, 255, 255, 0.8);
    padding: 22px 30px;
    border-radius: 16px;
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0 auto 30px auto;
    max-width: 800px;
    box-shadow: 0 6px 16px rgba(0,0,0,0.03);
    border: 1px solid rgba(226, 232, 240, 0.8);
    text-align: center;
  }
  .quote span {
    color: #0284c7;
    font-size: 1.4rem;
    font-weight: bold;
    padding: 0 4px;
  }

  /* KARTANING PASTKI QISMI (FOOTER BAR & SVG ICONS) */
  .card-footer-bar {
    position: relative;
    z-index: 1;
    width: 100%;
    border-top: 1px solid rgba(226, 232, 240, 0.8);
    padding-top: 20px;
    margin-top: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
  }
  .card-footer-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }
  .sub-text {
    font-size: 0.95rem;
    font-weight: 700;
    color: #0284c7;
  }
  .copy-text {
    font-size: 0.8rem;
    color: #64748b;
    font-weight: 600;
  }

  /* Chiroyli Ikonkali Tugmalar */
  .icon-buttons-row {
    display: flex;
    gap: 10px;
  }
  .icon-btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    box-shadow: 0 4px 10px rgba(0,0,0,0.06);
    border: 1px solid rgba(255,255,255,0.8);
  }
  .icon-btn svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
    transition: transform 0.2s;
  }
  .icon-btn:hover {
    transform: translateY(-3px) scale(1.08);
    box-shadow: 0 8px 20px rgba(0,0,0,0.12);
  }
  .icon-btn.call {
    background: #10b981;
    color: white;
  }
  .icon-btn.sms {
    background: #3b82f6;
    color: white;
  }
  .icon-btn.telegram {
    background: #0088cc;
    color: white;
  }
  .icon-btn.youtube {
    background: #ff0000;
    color: white;
  }

  @media (max-width: 768px) {
    .card-footer-bar {
      flex-direction: column;
      text-align: center;
    }
    .card-footer-text {
      align-items: center;
      text-align: center;
    }
    .icon-buttons-row {
      justify-content: center;
    }
  }

  .services-container {
    margin-top: 30px;
  }
  .section-title {
    text-align: center;
    font-size: 2rem;
    color: #0f172a;
    margin-bottom: 35px;
    font-weight: 850;
  }
  
  /* SECTIONS STACK */
  .sections-stack {
    display: flex;
    flex-direction: column;
    gap: 35px;
  }
  .procedure-section {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0,0,0,0.06);
    display: flex;
    flex-direction: column;
    transition: 0.3s;
  }
  .procedure-section:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(2, 132, 199, 0.1);
  }
  .procedure-video {
    width: 100%;
    height: 350px;
    background: #000;
  }
  .procedure-video iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
  .procedure-content {
    padding: 35px;
  }
  .procedure-content h3 {
    margin: 0 0 16px 0;
    font-size: 1.6rem;
    color: #0f172a;
    font-weight: 800;
  }
  .procedure-content p {
    margin: 0 0 10px 0;
    color: #475569;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .procedure-section {
      flex-direction: row;
      align-items: center;
    }
    .procedure-video {
      width: 45%;
      height: 380px;
    }
    .procedure-content {
      width: 55%;
    }
  }
  
  /* FOOTER STYLING */
  .site-footer {
    margin-top: 50px;
    display: flex;
    justify-content: center;
  }
  .footer-creative-card {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(240, 249, 255, 0.9) 100%);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border: 1px solid rgba(255, 255, 255, 1);
    border-radius: 32px;
    padding: 35px 30px;
    text-align: center;
    box-shadow: 
      0 25px 50px rgba(15, 23, 42, 0.08),
      0 4px 12px rgba(2, 132, 199, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 1);
  }
</style>
</html>
